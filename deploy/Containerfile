# Base images are pinned by tag and by index digest. To move one, resolve the
# new digest with `docker buildx imagetools inspect <image>:<tag>`.

FROM node:26-trixie-slim@sha256:930557a230abacbc3f4fd9b8648abf8f4bee1e17cb72195dcdfb2f709bc85b33 AS frontend
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY api/openapi.yaml /src/api/openapi.yaml
COPY VERSION /src/VERSION
COPY web/ ./
RUN npm run build

FROM golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
COPY --from=frontend /src/web/dist /src/web/dist
RUN CGO_ENABLED=0 go build -trimpath -o /out/capacity-room ./cmd/capacity-room

# The fake Prometheus of the end-to-end stack, on the same base as the runtime
# image. It needs only its own package and promtest, so a build with no cache
# rebuilds neither the frontend nor the product. `make e2e` builds it;
# `make image` never does.
FROM golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS fake-prometheus-build
WORKDIR /src
COPY go.mod go.sum ./
COPY internal/promtest/ ./internal/promtest/
COPY cmd/fake-prometheus/ ./cmd/fake-prometheus/
RUN CGO_ENABLED=0 go build -trimpath -o /out/fake-prometheus ./cmd/fake-prometheus

# Source of the typst binary only. The binary is statically linked, so it
# runs unchanged on the Debian and distroless stages below.
FROM ghcr.io/typst/typst:0.15.1@sha256:032e292249bcd378480cc7c142cfa324b63ef8aadeb88d7e7230320c4c9c422f AS typst

FROM golang:1.27.3@sha256:f20d83a83e18dbd2a4714b8ffd4b30b287b6243962dd75608e86abcc63ba4efc AS test
RUN apt-get update \
    && apt-get install --yes --no-install-recommends poppler-utils \
    && rm -rf /var/lib/apt/lists/*
COPY --from=typst /bin/typst /usr/local/bin/typst
RUN test "$(typst --version | cut -d' ' -f2)" = "0.15.1"
ADD --checksum=sha256:86584a54def73570558f66f5111cc53dfed56689637ae32c1201205d494f54fb \
    https://get.helm.sh/helm-v4.3.0-linux-amd64.tar.gz /opt/helm.tar.gz
ADD --checksum=sha256:9bc2bffbf71f261128533edaf912153948b7ff238f9a531ae6d34466ec287883 \
    https://github.com/yannh/kubeconform/releases/download/v0.8.0/kubeconform-linux-amd64.tar.gz /opt/kubeconform.tar.gz
RUN tar -xzf /opt/helm.tar.gz -C /usr/local/bin --strip-components=1 linux-amd64/helm \
    && tar -xzf /opt/kubeconform.tar.gz -C /usr/local/bin kubeconform \
    && rm /opt/helm.tar.gz /opt/kubeconform.tar.gz
RUN test "$(helm version --template '{{.Version}}')" = "v4.3.0"
RUN test "$(kubeconform -v)" = "v0.8.0"
RUN useradd --uid 10001 --user-group --no-create-home runner
# Dependencies are downloaded into the image because the source is mounted
# read-only when the tests run.
WORKDIR /deps
COPY go.mod go.sum ./
RUN go mod download && chmod -R a+rX /go/pkg
ENV GOCACHE=/tmp/gocache \
    HOME=/tmp \
    GOFLAGS=-mod=readonly
USER 10001:10001
WORKDIR /src

FROM gcr.io/distroless/static-debian13@sha256:034df5c1737e8241f6ed6423a12e720ee0f6d6f088609ee172f98f6f2166ef5d AS runtime
COPY --from=build /out/capacity-room /usr/local/bin/capacity-room
COPY --from=typst /bin/typst /usr/local/bin/typst
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/capacity-room"]

FROM gcr.io/distroless/static-debian13@sha256:034df5c1737e8241f6ed6423a12e720ee0f6d6f088609ee172f98f6f2166ef5d AS fake-prometheus
COPY --from=fake-prometheus-build /out/fake-prometheus /usr/local/bin/fake-prometheus
USER 10001:10001
ENTRYPOINT ["/usr/local/bin/fake-prometheus"]
